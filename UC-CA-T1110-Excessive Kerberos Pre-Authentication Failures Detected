Description:This use case detects excessive Kerberos Pre-Authentication Failures (Event ID 4771) generated by the same user account within a short time period. A high volume of authentication failures may indicate password spraying, brute-force attacks, account enumeration, attempts to authenticate using disabled accounts, or Kerberos configuration issues, enabling security teams to identify and investigate potential credential-based attacks.

KQL :

let Threshold = 50;
SecurityEvent
| where EventID == 4771
| where TargetUserName !endswith "$"
| where isnotempty(TargetUserName)
| where IpAddress !in ("-", "127.0.0.1", "::1")
| where Status in ("0x12","0x15","0x18","0x25")
| extend FailureReason = case(
        Status == "0x18", "Invalid Password (Possible Password Spraying/Brute Force)",
        Status == "0x12", "Authentication Attempt Using Disabled Account",
        Status == "0x15", "Unsupported Kerberos Encryption Type",
        Status == "0x25", "Clock Skew Too Great",
        "Other Kerberos Failure"
)
| summarize
    EventCount = count(),
    DistinctIPs = dcount(IpAddress),
    SourceIPs = make_set(IpAddress,20),
    StatusCodes = make_set(Status,10),
    FailureReasons = make_set(FailureReason,10),
    StartTime = min(TimeGenerated),
    EndTime = max(TimeGenerated)
by
    TargetUserName,
    Computer,
    bin(TimeGenerated,15m)
| where EventCount >= Threshold
| where DistinctIPs >= 2
| extend RuleName = "Excessive Kerberos Pre-Authentication Failures Detected"
| project
    StartTime,
    EndTime,
    RuleName,
    TargetUserName,
    Computer,
    EventCount,
    DistinctIPs,
    SourceIPs,
    StatusCodes,
    FailureReasons
| order by EventCount desc
